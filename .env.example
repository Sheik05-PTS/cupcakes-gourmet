# Copie para .env e ajuste os valores.
# Chave para assinar a sessão (gere com: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=troque-esta-chave

# Banco da aplicação
DATABASE_URL=postgresql://usuario:senha@localhost:5432/cupcakes

# Banco usado pelos testes automatizados (é apagado e recriado a cada execução)
DATABASE_URL_TESTE=postgresql://usuario:senha@localhost:5432/cupcakes_teste
